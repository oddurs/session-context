{
  "name": "session-context",
  "version": "0.1.0",
  "private": true,
  "description": "Everything one web page can learn about the browser, device and person that requested it — stated in plain English, with the raw values behind every claim.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddurs/session-context.git"
  },
  "homepage": "https://sessioncontext.org",
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build && node scripts/precompress.mjs",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "eslint",
    "start:next": "next start",
    "probe": "node scripts/probe.mjs",
    "probe:firefox": "node scripts/probe-firefox.mjs",
    "probe:safari": "node scripts/probe-safari.mjs"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "detectincognitojs": "^1.9.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ua-parser-js": "^1.0.41"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "^0.7.39",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
